{
  "name": "pms-project-management-syncboard",
  "version": "2.0.0",
  "private": true,
  "description": "PMS - a full-stack real-time Project Management SyncBoard",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:docker": "docker-compose up --build",
    "build": "npm run build --workspace client",
    "build:client": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "start:server": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "test:ci": "npm run test:ci --workspace server && npm run test:ci --workspace client && npm run build",
    "check": "npm run test:ci",
    "lint": "eslint \"client/src/**\" \"server/src/**\" --ext .js,.jsx --quiet",
    "lint:check": "eslint \"client/src/**\" \"server/src/**\" --ext .js,.jsx",
    "lint:fix": "eslint \"client/src/**\" \"server/src/**\" --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md,html}\"",
    "prepare": "husky install",
    "commit": "npx cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:docker": "docker-compose up --build",
    "build:client": "npm run build --workspace client",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md,html}\"",
    "lint:check": "eslint \"client/src/**\" \"server/src/**\" --ext .js,.jsx",
    "commit": "npx cz"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "@babel/eslint-parser": "^7.22.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-import": "^2.28.0",
    "prettier": "^2.8.8",
    "husky": "^9.1.7",
    "lint-staged": "^13.3.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0"
  },
  "lint-staged": {
    "client/src/**/*.{js,jsx,css,md,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "server/src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.19"
  }
}